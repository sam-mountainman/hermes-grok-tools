{
  "name": "grok-cli-tools",
  "version": "1.2.1",
  "description": "Relay Grok 4.5 answers verbatim at high reasoning effort and generate user-confirmed Grok Imagine media through the official Grok CLI.",
  "icon": "plugins/grok-cli-tools/assets/x-logo-black.png",
  "mcpServers": {
    "grok-cli": {
      "command": "python3",
      "args": [
        "${extensionPath}${/}plugins${/}grok-cli-tools${/}scripts${/}grok_cli_mcp.py"
      ],
      "cwd": "${extensionPath}",
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "contextFileName": "GEMINI.md"
}
